[
  {
    "name": "main window startup JS (eager modulepreload)",
    "path": [
      "dist/assets/main-*.js",
      "dist/assets/react-*.js",
      "dist/assets/radix-*.js",
      "dist/assets/alert-dialog-*.js",
      "dist/assets/xterm-*.js"
    ],
    "limit": "540 KB",
    "gzip": true
  },
  {
    "name": "total client JS",
    "path": ["dist/assets/*.js"],
    "limit": "1600 KB",
    "gzip": true
  },
  {
    "name": "Ghostty terminal JS (lazy)",
    "path": [
      "dist/assets/useGhosttyTerminalSession-*.js",
      "dist/assets/ghostty-vt-*.js"
    ],
    "limit": "55 KB",
    "gzip": true
  },
  {
    "name": "Ghostty terminal WASM (lazy)",
    "path": ["dist/assets/ghostty-vt-*.wasm"],
    "limit": "200 KB",
    "gzip": true
  }
]
