{
  "$schema": "vscode://schemas/color-theme",
  "name": "Terax Tokyo Night Session",
  "type": "dark",
  "semanticHighlighting": true,
  "colors": {
    "foreground": "#c0caf5",
    "descriptionForeground": "#a9b1d6",
    "focusBorder": "#7aa2f7",
    "errorForeground": "#f7768e",
